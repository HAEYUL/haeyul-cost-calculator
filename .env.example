VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 (VITE_ 접두사 없음 — 브라우저에 노출되지 않음)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# 매장 로그인(보안 잠금)용 서버 전용 값 — Vercel 환경 변수에도 넣어야 한다
# Supabase → Project Settings → API Keys → service_role (secret). 절대 VITE_ 접두사를 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 아무도 모르는 긴 임의 문자열(예: openssl rand -hex 32). 매장·관리자 계정 비밀번호와 파출 주민번호 암호화에 쓴다.
# ⚠️ 한 번 정하면 절대 바꾸지 말 것 (바꾸면 저장된 파출 주민번호를 읽을 수 없게 된다)
STORE_AUTH_SECRET=change-me-to-a-long-random-string
